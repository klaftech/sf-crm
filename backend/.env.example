# Flask Configuration
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_SECRET_KEY=your-secret-key-here

# Database Type Configuration
# Set to 'sqlite' for local testing or 'mysql' for production
DB_TYPE=mysql

# SQLite Database Configuration (for testing)
# Only used when DB_TYPE=sqlite
SQLITE_CRM_DB_PATH=crm_test.db
SQLITE_ERP_DB_PATH=erp_test.db

# ERP Database Configuration (MySQL - Read Only)
# Only used when DB_TYPE=mysql
ERP_DB_SERVER=your-mysql-host.com
ERP_DB_PORT=3306
ERP_DB_NAME=erp_database
ERP_DB_USERNAME=readonly_user
ERP_DB_PASSWORD=your-password-here
ERP_DB_SSL_CA=/path/to/ca-cert.pem  # Optional: Path to SSL CA certificate

# CRM Database Configuration (MySQL)
# Only used when DB_TYPE=mysql
CRM_DB_SERVER=your-mysql-host.com
CRM_DB_PORT=3306
CRM_DB_NAME=crm_database
CRM_DB_USERNAME=crm_user
CRM_DB_PASSWORD=your-password-here
CRM_DB_SSL_CA=/path/to/ca-cert.pem  # Optional: Path to SSL CA certificate

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
