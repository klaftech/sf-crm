# Flask Configuration
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_SECRET_KEY=your-secret-key-here

# Database Type Configuration
# Set to 'sqlite' for local testing or 'sqlserver' for production
DB_TYPE=sqlserver

# SQLite Database Configuration (for testing)
# Only used when DB_TYPE=sqlite
SQLITE_CRM_DB_PATH=crm_test.db
SQLITE_ERP_DB_PATH=erp_test.db

# ERP Database Configuration (SQL Server - Read Only)
# Only used when DB_TYPE=sqlserver
ERP_DB_SERVER=your-erp-server.database.windows.net
ERP_DB_NAME=erp_database
ERP_DB_USERNAME=readonly_user
ERP_DB_PASSWORD=your-password-here
ERP_DB_DRIVER=ODBC Driver 17 for SQL Server

# CRM Database Configuration (SQL Server)
# Only used when DB_TYPE=sqlserver
CRM_DB_SERVER=your-crm-server.database.windows.net
CRM_DB_NAME=crm_database
CRM_DB_USERNAME=crm_user
CRM_DB_PASSWORD=your-password-here
CRM_DB_DRIVER=ODBC Driver 17 for SQL Server

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
